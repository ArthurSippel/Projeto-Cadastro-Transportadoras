<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <title>Nova Transportadora</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>

    <h1>Nova Transportadora</h1>

    <form action="/transportadoras/adicionar" method="POST">

        <label>Nome</label><br>
        <input type="text" name="nome_transp"><br><br>

        <label>Quantidade de veículos</label><br>
        <input type="number" name="veiculos_transp"><br><br>

        <label>Região</label><br>
        <select name="id_regiao" required>
                        <% regioes.forEach(regioes => { %>
                            <option value="<%= regioes.id_regiao %>">
                                <%= regioes.nome_regiao %>
                            </option>
                        <% }) %>
                    </select><br><br>

        <button type="submit">
            Salvar
        </button>

    </form>

</body>
</html>
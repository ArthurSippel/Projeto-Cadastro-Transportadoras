<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <title>Nova Transportadora</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>

    <div class="caixa_login">

        <h2>Cadastrar Transportadora</h2>

        <form action="/transportadoras/adicionar" method="POST">

            <label>Nome:</label>
            <input type="text" name="nome_transp" class="caixa_texto_login" required>

            <label>Nº de Veículos:</label>
            <input type="number" name="veiculos_transp" class="caixa_texto_login" required>

            <label>Região:</label>
            <input type="text" name="regiao_transp" class="caixa_texto_login" required>

            <button type="submit" class="btn_login"> Salvar </button>

        </form>
        
        <a href="/transportadoras">
            <button type="button" class="btn_login"> Voltar </button>
        </a>
    </div>

</body>
</html>